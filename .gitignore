# --- Environments ---
.venv/
venv/
env/
ENV/

# --- Python Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Artifacts (models, weights, encoders, metadata) ---
artifacts/

# --- Outputs (generated plots and figures) ---
outputs/

# --- Maps (the user's own data) ---
# The directory the interface opens maps from, and the one the compose file bind
# mounts at /data. It holds the user's spectra, so it is not part of the repository.
data/

# --- Logs & Checkpoints ---
logs/
*.ckpt
*.pb
*.tflite

# --- Jupyter ---
.ipynb_checkpoints/

# --- Distribution / Packaging ---
dist/
build/
*.egg-info/

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Local Tooling ---
# The project instructions and the agent scaffolding around them are written for
# this machine rather than for the pipeline. A vendored skill also goes stale
# against the CLI that serves its current version.
CLAUDE.md
.claude/
.lavish/

# --- Retired code ---
# Code removed from the pipeline but worth keeping readable on disk. It is not
# part of the package and a fresh clone will not have it; git history holds the
# record of what was removed.
legacy/